{
  "name": "@tokvera/sdk",
  "version": "0.2.3",
  "description": "Tokvera TypeScript SDK for OpenAI, Anthropic, and Gemini call tracking.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:schema-compat": "vitest run tests/eventEnvelopeV1.contract.test.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsup": "^8.0.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
